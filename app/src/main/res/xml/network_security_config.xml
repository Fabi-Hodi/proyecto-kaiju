<?xml version="1.0" encoding="utf-8"?>
<!-- Android bloquea HTTP sin cifrar por defecto. Aquí se permite SOLO para el EC2 del backend;
     el resto de las conexiones (como mindicador.cl) siguen exigiendo HTTPS -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">34.228.244.224</domain>
    </domain-config>
</network-security-config>